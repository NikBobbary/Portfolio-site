{
  "redirects": [
    {
      "source": "/play",
      "destination": "https://play.nikbobbary.com",
      "permanent": false
    },
    {
      "source": "/play/:path*",
      "destination": "https://play.nikbobbary.com",
      "permanent": false
    },
    {
      "source": "/~play",
      "destination": "https://play.nikbobbary.com",
      "permanent": false
    },
    {
      "source": "/~/play",
      "destination": "https://play.nikbobbary.com",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "work.nikbobbary.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
