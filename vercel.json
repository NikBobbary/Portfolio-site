{
  "redirects": [
    {
      "source": "/play",
      "has": [
        {
          "type": "host",
          "value": "work.nikbobbary.com"
        }
      ],
      "destination": "https://play.nikbobbary.com",
      "permanent": false
    },
    {
      "source": "/play",
      "has": [
        {
          "type": "host",
          "value": "nikbobbary.com"
        }
      ],
      "destination": "https://play.nikbobbary.com",
      "permanent": false
    },
    {
      "source": "/~play",
      "destination": "https://play.nikbobbary.com",
      "permanent": false
    },
    {
      "source": "/~/play",
      "destination": "https://play.nikbobbary.com",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/play-assets/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/play/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "work.nikbobbary.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
